# ---- Server ----
NODE_ENV=development
PORT=5000
# Origin allowed by CORS. Must match where the frontend is served from.
FRONTEND_URL=http://localhost:5173

# ---- Database (MongoDB Atlas) ----
# Atlas: Database > Connect > Drivers. Remember to URL-encode a password with special chars.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-cv-analyzer?retryWrites=true&w=majority

# ---- Google Gemini (AI Studio: https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=your-gemini-api-key-here
# Free-tier eligibility and RPM/RPD are per-project. Check your live limits at
# https://aistudio.google.com/rate-limit before changing this.
GEMINI_MODEL=gemini-2.5-flash

# ---- Auth0 (API / backend side) ----
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.ai-cv-analyzer.com
